{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2017",
    "module": "nodenext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["reflect-metadata"],
    "paths": {
      "@/*": ["src/*"]
    },
    "moduleResolution": "NodeNext"
  },
  "include": ["src/**/*.ts"]
}
