{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm -r build",
  "functions": {
    "apps/blog-service/src/api/index.ts": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    {
      "src": "/blog/(.*)",
      "dest": "apps/blog-service/src/api/index.ts"
    }
  ]
}