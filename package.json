{
  "name": "backend-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:blog": "pnpm --filter blog-api dev",
    "dev:puzzle": "pnpm --filter puzzle-api dev",
    "build": "pnpm --filter \"./apps/**\" --filter \"./libs/**\" build",
    "build:blog": "pnpm --filter blog-api build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "latest",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
