{
  "name": "backend-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:blog": "pnpm --filter blog-api dev",
    "dev:puzzle": "pnpm --filter puzzle-api dev",
    "build": "pnpm --filter \"./apps/**\" --filter \"./libs/**\" build",
    "build:blog": "pnpm --filter blog-api build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/auth": "^5.0.4",
    "@fastify/env": "^6.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.49",
    "ajv-formats": "^3.0.1",
    "convex": "^1.36.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "jwks-rsa": "^4.0.1",
    "mediatr-ts": "^2.2.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "latest",
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
