{
  "name": "backend-service",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "clean:build": "pnpm -r run clean:build",
    "build:libs": "pnpm --filter \"./lib/**\" run build",
    "build:apps": "pnpm --filter \"./apps/**\" run build",
    "dev:admin": "pnpm --filter admin-service... --parallel run dev",
    "dev:auth": "pnpm --filter auth-service... --parallel run dev",
    "dev:blog": "pnpm --filter blog-service... --parallel run dev",
    "dev:game": "pnpm --filter game-service... --parallel run dev",
    "start:admin": "pnpm --filter admin-service run start",
    "start:auth": "pnpm --filter auth-service run start",
    "start:blog": "pnpm --filter blog-service run start",
    "start:game": "pnpm --filter game-service run start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@swc/core": "^1.15.43",
    "@types/node": "latest",
    "@vercel/node": "^5.8.12",
    "@vitest/coverage-v8": "^4.1.5",
    "cpy-cli": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": [
      "biome check --write"
    ]
  }
}
